lothlorien.message.deer.stop_leashed=§7Bílý jelen je na vodítku, a tak vás přestal vést.
lothlorien.message.deer.gift=§fBílý jelen se zastavil a sklonil hlavu. V mechu se něco zalesklo: ořech velkého mallornu.
lothlorien.message.deer.accept=§fBílý jelen vzal žalud, zvedl hlavu a otočil se. Následujte ho.
lothlorien.message.deer.no_path=§7Bílý jelen se rozhlíží, ale nenachází cestu dál.
