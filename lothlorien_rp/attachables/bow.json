{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "lothlorien:bow",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/items/galadhrim_bow",
        "bow_pulling_0": "textures/items/galadhrim_bow_pulling_0",
        "bow_pulling_1": "textures/items/galadhrim_bow_pulling_1",
        "bow_pulling_2": "textures/items/galadhrim_bow_pulling_2",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.bow_standby",
        "bow_pulling_0": "geometry.bow_pulling_0",
        "bow_pulling_1": "geometry.bow_pulling_1",
        "bow_pulling_2": "geometry.bow_pulling_2"
      },
      "animations": {
        "wield": "animation.bow.wield",
        "wield_first_person_pull": "animation.bow.wield_first_person_pull",
        "grip": "animation.lothlorien.bow.grip"
      },
      "scripts": {
        "pre_animation": [
          "variable.charge_amount = math.clamp((query.main_hand_item_max_duration - (query.main_hand_item_use_duration - query.frame_alpha + 1.0)) / 16.0, 0.0, 1.0);",
          "variable.bow_tex_idx = query.main_hand_item_use_duration <= 0.0 ? 0 : (variable.charge_amount < 0.65 ? 1 : (variable.charge_amount < 0.9 ? 2 : 3));"
        ],
        "animate": [
          "wield",
          {
            "wield_first_person_pull": "query.main_hand_item_use_duration > 0.0 && c.is_first_person"
          },
          "grip"
        ]
      },
      "render_controllers": [
        "controller.render.lothlorien.bow"
      ]
    }
  }
}
