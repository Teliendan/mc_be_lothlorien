{
  "format_version": "1.8.0",
  "animations": {
    "animation.lothlorien.mallorn_boat.turn": {
      "loop": true,
      "bones": {
        "hull": {
          "rotation": [0, "query.body_y_rotation - query.target_y_rotation", 0],
          "position": [0, 3, 0]
        }
      }
    },
    "animation.lothlorien.mallorn_boat.row": {
      "loop": true,
      "bones": {
        "paddle_left": {
          "rotation": ["12 * math.cos(variable.paddle) * variable.row", "30 * math.sin(variable.paddle) * variable.row", 0]
        },
        "paddle_right": {
          "rotation": ["-12 * math.cos(variable.paddle) * variable.row", "-30 * math.sin(variable.paddle) * variable.row", 0]
        }
      }
    },
    "animation.lothlorien.mallorn_boat.wobble": {
      "loop": true,
      "bones": {
        "hull": {
          "rotation": ["variable.wobble_t < 0.5 ? math.sin((10 - variable.wobble_t * 20) * 57.3) * (10 - variable.wobble_t * 20) * (10 - variable.wobble_t * 20) / 10 * (math.mod(variable.hits, 2) == 0 ? 1 : -1) : 0", 0, 0]
        }
      }
    }
  }
}
