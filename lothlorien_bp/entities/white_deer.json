        "set_property": {
          "lothlorien:guiding": true
        },
        "remove": {
          "component_groups": [
            "lothlorien:state_wild",
            "lothlorien:state_tame",
            "lothlorien:state_alarmed",
            "lothlorien:state_guiding"
          ]
        },
        "add": {
          "component_groups": [
            "lothlorien:state_guiding"
          ]
        }
      },
      "lothlorien:guide_end": {
        "set_property": {
          "lothlorien:guiding": false
        },
        "remove": {
          "component_groups": [
            "lothlorien:state_guiding"
          ]
        },
        "trigger": "lothlorien:alarm_over"
      },
      "lothlorien:become_tame": {
        "sequence": [
          {
            "set_property": {
              "lothlorien:tame": true
            },
            "add": {
              "component_groups": [
                "lothlorien:kept"
              ]
            }
          },
          {
            "filters": {
              "all_of": [
                {
                  "test": "bool_property",
                  "domain": "lothlorien:alarmed",
                  "value": false
                },
                {
                  "test": "bool_property",
                  "domain": "lothlorien:guiding",
                  "value": false
                }
              ]
            },
            "remove": {
              "component_groups": [
                "lothlorien:state_wild"
              ]
            },
            "add": {
              "component_groups": [
                "lothlorien:state_tame"
              ]
            }
          }
        ]
      },
      "lothlorien:untame": {
        "sequence": [
          {
            "set_property": {
              "lothlorien:tame": false
            }
          },
          {
            "filters": {
              "test": "is_leashed",
              "value": false
            },
            "remove": {
              "component_groups": [
                "lothlorien:kept"
              ]
            }
          }
        ]
      },
      "lothlorien:leashed": {
        "add": {
          "component_groups": [
            "lothlorien:kept"
          ]
        }
      },
      "lothlorien:unleashed": {
        "sequence": [
          {
            "filters": {
              "test": "bool_property",
              "domain": "lothlorien:tame",
              "value": false
            },
            "remove": {
              "component_groups": [
                "lothlorien:kept"
              ]
            }
          }
        ]
      }
    }
  }
}
