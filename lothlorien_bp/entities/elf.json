{
  "format_version": "1.26.50",
  "minecraft:entity": {
    "description": {
      "identifier": "lothlorien:elf",
      "spawn_category": "creature",
      "is_spawnable": true,
      "is_summonable": true
    },
    "component_groups": {
      "lothlorien:gardener": {
        "minecraft:variant": {
          "value": 0
        }
      },
      "lothlorien:healer": {
        "minecraft:variant": {
          "value": 1
        }
      },
      "lothlorien:woodwright": {
        "minecraft:variant": {
          "value": 2
        }
      },
      "lothlorien:lamplighter": {
        "minecraft:variant": {
          "value": 3
        }
      },
      "lothlorien:loremaster": {
        "minecraft:variant": {
          "value": 4
        },
        "minecraft:interact": {
          "interactions": [
            {
              "on_interact": {
                "filters": {
                  "all_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "player"
                    },
                    {
                      "none_of": [
                        {
                          "test": "has_equipment",
                          "domain": "hand",
                          "subject": "other",
                          "value": "minecraft:lead"
                        },
                        {
                          "test": "has_equipment",
                          "domain": "hand",
                          "subject": "other",
                          "value": "minecraft:name_tag"
                        }
                      ]
                    }
                  ]
                }
              },
              "use_item": false,
              "swing": true,
              "interact_text": "action.interact.lothlorien.speak"
            }
          ]
        }
      },
      "lothlorien:home_near": {
        "minecraft:home": {
          "restriction_type": "random_movement",
          "restriction_radius": 10
        },
        "minecraft:mark_variant": {
          "value": 1
        }
      },
      "lothlorien:home_lore": {
        "minecraft:home": {
          "restriction_type": "random_movement",
          "restriction_radius": 6
        },
        "minecraft:mark_variant": {
          "value": 2
        }
      },
      "lothlorien:healer_day": {
        "minecraft:home": {
          "restriction_type": "random_movement",
          "restriction_radius": 64
        },
        "minecraft:mark_variant": {
          "value": 3
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 0.6,
          "xz_dist": 32,
          "y_dist": 4
        },
        "minecraft:follow_range": {
          "value": 64,
          "max": 64
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "test": "is_daytime",
                "subject": "self",
                "operator": "==",
                "value": false
              },
              "event": "lothlorien:healer_dusk",
              "target": "self"
            }
          ]
        }
      },
      "lothlorien:healer_night": {
        "minecraft:home": {
          "restriction_type": "random_movement",
          "restriction_radius": 10
        },
        "minecraft:mark_variant": {
          "value": 4
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 0.6,
          "xz_dist": 8,
          "y_dist": 3
        },
        "minecraft:follow_range": {
          "value": 64,
          "max": 64
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "test": "is_daytime",
                "subject": "self",
                "operator": "==",
                "value": true
              },
              "event": "lothlorien:healer_dawn",
              "target": "self"
            }
          ]
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "lothlorien_elf",
          "mob"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.95
      },
      "minecraft:health": {
        "value": 20,
        "max": 20
      },
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "can_pass_doors": true,
        "can_open_doors": false,
        "blocks_to_avoid": [
          {
            "name": "lothlorien:elven_rope"
          },
          {
            "name": "lothlorien:elven_rope_hanging"
          }
        ]
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:pushable_by_entity": {},
      "minecraft:pushable_by_block": {},
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self"
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": "no"
          }
        ]
      },
      "minecraft:nameable": {},
      "minecraft:persistent": {},
      "minecraft:home": {},
      "minecraft:leashable": {
        "can_be_stolen": false,
        "can_be_cut": true,
        "on_leash": {
          "event": "lothlorien:leashed",
          "target": "self"
        },
        "on_unleash": {
          "event": "lothlorien:rehome",
          "target": "self"
        },
        "presets": [
          {
            "soft_distance": 4,
            "hard_distance": 6,
            "max_distance": 10
          }
        ]
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.25
      },
      "minecraft:behavior.avoid_mob_type": {
        "priority": 2,
        "entity_types": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "monster"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "enderman",
                  "operator": "!="
                }
              ]
            },
            "max_dist": 6,
            "walk_speed_multiplier": 1.0,
            "sprint_speed_multiplier": 1.25
          }
        ]
      },
      "minecraft:behavior.move_towards_home_restriction": {
        "priority": 5,
        "speed_multiplier": 0.6
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.6,
        "xz_dist": 8,
        "y_dist": 3
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 8,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      }
    },
    "events": {
      "lothlorien:as_gardener": {
        "remove": {
          "component_groups": [
            "lothlorien:healer",
            "lothlorien:woodwright",
            "lothlorien:lamplighter",
            "lothlorien:loremaster",
            "lothlorien:home_lore",
            "lothlorien:healer_day",
            "lothlorien:healer_night"
          ]
        },
        "add": {
          "component_groups": [
            "lothlorien:gardener",
            "lothlorien:home_near"
          ]
        }
      },
      "lothlorien:as_healer": {
        "remove": {
          "component_groups": [
            "lothlorien:gardener",
            "lothlorien:woodwright",
            "lothlorien:lamplighter",
            "lothlorien:loremaster",
            "lothlorien:home_near",
            "lothlorien:home_lore",
            "lothlorien:healer_night"
          ]
        },
        "add": {
          "component_groups": [
            "lothlorien:healer",
            "lothlorien:healer_day"
          ]
        }
      },
      "lothlorien:as_woodwright": {
        "remove": {
          "component_groups": [
            "lothlorien:gardener",
            "lothlorien:healer",
            "lothlorien:lamplighter",
            "lothlorien:loremaster",
            "lothlorien:home_lore",
            "lothlorien:healer_day",
            "lothlorien:healer_night"
          ]
        },
        "add": {
          "component_groups": [
            "lothlorien:woodwright",
            "lothlorien:home_near"
          ]
        }
      },
      "lothlorien:as_lamplighter": {
        "remove": {
          "component_groups": [
            "lothlorien:gardener",
            "lothlorien:healer",
            "lothlorien:woodwright",
            "lothlorien:loremaster",
            "lothlorien:home_lore",
            "lothlorien:healer_day",
            "lothlorien:healer_night"
          ]
        },
        "add": {
          "component_groups": [
            "lothlorien:lamplighter",
            "lothlorien:home_near"
          ]
        }
      },
      "lothlorien:as_loremaster": {
        "remove": {
          "component_groups": [
            "lothlorien:gardener",
            "lothlorien:healer",
            "lothlorien:woodwright",
            "lothlorien:lamplighter",
            "lothlorien:home_near",
            "lothlorien:healer_day",
            "lothlorien:healer_night"
          ]
        },
        "add": {
          "component_groups": [
            "lothlorien:loremaster",
            "lothlorien:home_lore"
          ]
        }
      },
      "lothlorien:leashed": {
        "remove": {
          "component_groups": [
            "lothlorien:home_near",
            "lothlorien:home_lore",
            "lothlorien:healer_day",
            "lothlorien:healer_night"
          ]
        }
      },
      "lothlorien:rehome": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "lothlorien:home_near",
                "lothlorien:home_lore",
                "lothlorien:healer_day",
                "lothlorien:healer_night"
              ]
            },
            "set_home_position": {}
          },
          {
            "filters": {
              "test": "is_variant",
              "subject": "self",
              "operator": "==",
              "value": 4
            },
            "add": {
              "component_groups": [
                "lothlorien:home_lore"
              ]
            }
          },
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_variant",
                  "subject": "self",
                  "operator": "!=",
                  "value": 4
                },
                {
                  "test": "is_variant",
                  "subject": "self",
                  "operator": "!=",
                  "value": 1
                }
              ]
            },
            "add": {
              "component_groups": [
                "lothlorien:home_near"
              ]
            }
          },
          {
            "filters": {
              "test": "is_variant",
              "subject": "self",
              "operator": "==",
              "value": 1
            },
            "add": {
              "component_groups": [
                "lothlorien:healer_day"
              ]
            }
          },
          {
            "set_home_position": {}
          }
        ]
      },
      "lothlorien:healer_dusk": {
        "remove": {
          "component_groups": [
            "lothlorien:healer_day"
          ]
        },
        "add": {
          "component_groups": [
            "lothlorien:healer_night"
          ]
        }
      },
      "lothlorien:healer_dawn": {
        "remove": {
          "component_groups": [
            "lothlorien:healer_night"
          ]
        },
        "add": {
          "component_groups": [
            "lothlorien:healer_day"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "randomize": [
          {
            "weight": 1,
            "add": {
              "component_groups": [
                "lothlorien:gardener",
                "lothlorien:home_near"
              ]
            }
          },
          {
            "weight": 1,
            "add": {
              "component_groups": [
                "lothlorien:healer",
                "lothlorien:healer_day"
              ]
            }
          },
          {
            "weight": 1,
            "add": {
              "component_groups": [
                "lothlorien:woodwright",
                "lothlorien:home_near"
              ]
            }
          },
          {
            "weight": 1,
            "add": {
              "component_groups": [
                "lothlorien:lamplighter",
                "lothlorien:home_near"
              ]
            }
          },
          {
            "weight": 1,
            "add": {
              "component_groups": [
                "lothlorien:loremaster",
                "lothlorien:home_lore"
              ]
            }
          }
        ],
        "filters": {
          "test": "has_component",
          "operator": "!=",
          "value": "minecraft:variant"
        }
      }
