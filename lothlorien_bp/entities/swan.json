      "lothlorien:spawn_cygnet": {
        "remove": {
          "component_groups": [
            "lothlorien:adult",
            "lothlorien:shedding_test"
          ]
        },
        "add": {
          "component_groups": [
            "lothlorien:baby"
          ]
        },
        "set_property": {
          "lothlorien:adult_ready": false
        }
      },
      "minecraft:entity_born": {
        "sequence": [
          {
            "trigger": "lothlorien:spawn_cygnet"
          },
          {
            "trigger": "lothlorien:set_calm"
          },
          {
            "trigger": "lothlorien:fed"
          }
        ]
      },
      "lothlorien:shed_feather": {
        "set_property": {
          "lothlorien:shed_phase": "!query.property('lothlorien:shed_phase')"
        }
      },
      "lothlorien:test_shedding": {
        "sequence": [
          {
            "filters": {
              "test": "is_baby",
              "subject": "self",
              "value": false
            },
            "remove": {
              "component_groups": [
                "lothlorien:adult",
                "lothlorien:shedding_test"
              ]
            },
            "add": {
              "component_groups": [
                "lothlorien:shedding_test"
              ]
            }
          }
        ]
      },
      "lothlorien:test_shedding_done": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "lothlorien:shedding_test"
              ]
            }
          },
          {
            "trigger": "minecraft:ageable_grow_up"
          },
          {
            "trigger": "lothlorien:shed_feather"
          }
        ]
      }
    }
  }
}
